# Copie para .env (o servidor lê automaticamente) e ajuste.

# Token único de acesso (obrigatório, 16+ caracteres). Gere com: openssl rand -hex 24
RUMO_TOKEN=

# Porta e interface (0.0.0.0 aceita conexões da rede; 127.0.0.1 só local).
RUMO_PORTA=8787
RUMO_HOST=0.0.0.0

# Pasta do banco SQLite, das chaves VAPID (notificações) e dos backups diários.
RUMO_DADOS=./dados

# Origens liberadas no CORS, separadas por vírgula (ex.: https://seu-site.netlify.app).
# "*" aceita qualquer uma; as rotas continuam protegidas pelo token.
RUMO_ORIGENS=*

# Contato exigido pelo Web Push (mailto: ou https:).
RUMO_CONTATO=mailto:voce@exemplo.com
